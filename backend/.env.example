# --- Database ---
DATABASE_URL=postgresql://thermal_user:thermal_pass@localhost:5432/thermal_db

# --- NASA FIRMS API ---
# Get a free MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_firms_map_key_here
# Sensor source: VIIRS_SNPP_NRT, VIIRS_NOAA20_NRT, MODIS_NRT
FIRMS_SOURCE=VIIRS_SNPP_NRT
# Bounding box for the demo region: west,south,east,north
FIRMS_BBOX=68.0,6.0,97.0,37.0
# How many days back FIRMS should return (1-10)
FIRMS_DAY_RANGE=1

# --- OSM Overpass ---
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Bounding box for OSM industrial polygon fetch: south,west,north,east
OSM_BBOX=6.0,68.0,37.0,97.0

# --- Ingestion scheduler ---
FIRMS_POLL_INTERVAL_MINUTES=360
OSM_REFRESH_INTERVAL_HOURS=168

# --- Spatial matching ---
INDUSTRIAL_BUFFER_METERS=500

# --- Anomaly detection ---
ANOMALY_ZSCORE_THRESHOLD=3.0
MIN_HISTORY_POINTS_FOR_ZSCORE=5

# --- App ---
ENV=development
LOG_LEVEL=INFO
